    "module": 0,
    "section": "Security Basics",
    "domain": "D0",
    "kind": "term",
    "front": "Non-repudiation",
    "back": "A sender cannot deny having sent a message or performed an action. Provided by **digital signatures** (asymmetric keys). Symmetric keys cannot provide it, because both parties hold the same key.",
    "tags": [
      "cia",
      "non-repudiation"
    ],
    "sources": [
      "https://csrc.nist.gov/glossary/term/non_repudiation",
      "https://csrc.nist.gov/pubs/sp/800/12/r1/final"
