  },
  {
    "id": "m00-c-0005",
    "module": 0,
    "section": "Networking Essentials",
    "domain": "D0",
    "kind": "term",
    "front": "TCP vs UDP",
    "back": "**TCP**: connection-oriented (handshake), reliable (ACKs, retransmission, ordering), 20–60-byte header. Web, mail, SSH.\n\n**UDP**: connectionless, best effort, 8-byte header. DNS queries, DHCP, SNMP, NTP, streaming.",
    "tags": [
      "tcp",
      "udp"
    ],
    "sources": [
      "https://www.rfc-editor.org/rfc/rfc768",
      "https://www.rfc-editor.org/rfc/rfc9293"
    ],
    "verify": false,
    "rev": 1
  },
