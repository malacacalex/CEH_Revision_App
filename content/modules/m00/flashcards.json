    "section": "Operating System Essentials",
    "domain": "D0",
    "kind": "term",
    "front": "/etc/passwd vs /etc/shadow",
    "back": "**/etc/passwd**: accounts (user, UID, GID, home, shell); readable by everyone.\n\n**/etc/shadow**: password hashes and ageing; readable by **root only**. UID 0 = root.",
    "tags": [
      "linux",
      "accounts"
    ],
    "sources": [
      "https://man7.org/linux/man-pages/man5/passwd.5.html",
      "https://man7.org/linux/man-pages/man5/shadow.5.html"
