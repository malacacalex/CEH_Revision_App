    "module": 0,
    "section": "Security Basics",
    "domain": "D0",
    "kind": "list",
    "front": "CIA triad",
    "back": "- **Confidentiality**: no unauthorized disclosure (encryption, access control)\n- **Integrity**: no unauthorized change (hashes, signatures)\n- **Availability**: reliable, timely access (redundancy, backups)",
    "tags": [
      "cia"
    ],
    "sources": [
      "https://csrc.nist.gov/glossary/term/confidentiality",
      "https://csrc.nist.gov/pubs/sp/800/12/r1/final"
    ],
